# Set a unique local database password before starting Docker Compose.
POSTGRES_PASSWORD=
WEB_PORT=8080
# Optional exact browser origin. Defaults to http://localhost:<WEB_PORT>.
# APP_ORIGIN=http://localhost:8080
# Fixed session lifetime: 60-86400 seconds. HTTPS origins use Secure cookies.
SESSION_TTL_SECONDS=28800
# Shared live snapshot cache. The 300-second default stays within anonymous
# OpenSky credits for the configured 25-square-degree regional request.
AVIATION_CACHE_TTL_SECONDS=300
# Optional OpenSky OAuth client. Configure both values or leave both empty.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional provider overrides for development or compatible test services.
# AVIATION_API_BASE_URL=https://opensky-network.org/api
# OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
